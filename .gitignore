# macOS
.DS_Store
._*

# Secrets et état local
# hosts.yml ne contient pas de token aujourd'hui (gh passe par le Keychain),
# mais `gh auth login --insecure-storage` en écrirait un en clair.
home/.config/gh/hosts.yml
home/.config/nvim/lazy-lock.json.bak
*.local
*.secret

# Neovim
home/.config/nvim/.netrwhist

# yazi : flavors et plugins sont du code tiers cloné par `ya pkg install`,
# que install.sh rejoue depuis package.toml.
home/.config/yazi/flavors/
home/.config/yazi/plugins/

# tmux : filet de sécurité. tmux.conf fixe TMUX_PLUGIN_MANAGER_PATH hors du
# repo, mais sans cette variable tpm installerait ici, dans le dépôt.
home/.config/tmux/plugins/
