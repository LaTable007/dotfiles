#!/bin/bash

# Fallback only: AeroSpace launches borders with explicit arguments (see
# after-startup-command in aerospace.toml), and those win over this file.
# Kept in sync with it so both paths render identically.
# Gruvbox: active = YELLOW (fabd2f), inactive = BG1 (3c3836).
options=(
  style=round
  width=5.0
  hidpi=off
  active_color=0xfffabd2f
  inactive_color=0xff3c3836
)

borders "${options[@]}"
