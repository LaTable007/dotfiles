// Preset par défaut de fastfetch, moins le module "localip".
//
// fastfetch s'exécute à chaque ouverture de shell : l'adresse locale se
// retrouvait donc sur toute capture d'écran du terminal. Sur un réseau
// domestique elle est privée et sans intérêt, mais certains réseaux
// attribuent une IPv4 publique directement à la machine — l'item réseau de
// SketchyBar signale ce cas en orange — et elle partait alors dans le dépôt.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "wmtheme",
    "theme",
    "font",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
